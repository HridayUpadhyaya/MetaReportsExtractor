# Local development: SQLite is used if DATABASE_URL is omitted.
DATABASE_URL=sqlite:///./meta_india.db

# Meta source
META_HUB_URL=https://transparency.meta.com/reports/regulatory-transparency-reports/
META_COUNTRY=India
META_DOWNLOAD_DELAY_SECONDS=2.5
HTTP_MAX_RETRIES=5
PLAYWRIGHT_FALLBACK=true

# Railway Bucket / generic S3-compatible storage. Leave blank locally to use ./storage.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
ENDPOINT=

# Optional AI exception verifier. Deterministic extraction remains primary.
AI_VERIFY_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_AUTOFIX=false

# Protect the "Run sync" button/API. Use a long random value in production.
ADMIN_TOKEN=change-me

# Website
APP_NAME=Meta India Report Pipeline
POLL_SECONDS=3
